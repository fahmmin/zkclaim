{
  "name": "zkclaim",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "contract",
    "cli",
    "ui"
  ],
  "scripts": {
    "compile": "npm run compile -w contract",
    "test": "npm test -w contract",
    "demo": "npm run demo -w cli",
    "fund": "npm run fund -w cli --",
    "ui": "npm run dev -w ui",
    "e2e:open": "node e2e/open.ts",
    "e2e": "playwright test -c e2e",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/zkir-v3": "3.2.1",
    "vite-plugin-top-level-await": {
      "@swc/core": "1.15.47",
      "uuid": "11.1.1"
    }
  }
}
